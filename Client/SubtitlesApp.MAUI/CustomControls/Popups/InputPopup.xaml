<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels.Popups"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  x:DataType="viewModels:InputPopupViewModel"
  x:Class="SubtitlesApp.CustomControls.Popups.InputPopup"
  x:TypeArguments="system:String"
  CanBeDismissedByTappingOutsideOfPopup="False"
  BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBackground}, Light={StaticResource White}}"
>
  <toolkit:Popup.Resources>
    <Style x:Key="InvalidEntryStyle" TargetType="Entry">
      <Setter Property="TextColor" Value="Grey" />
    </Style>
  </toolkit:Popup.Resources>

  <Grid HeightRequest="150" WidthRequest="300" RowDefinitions="*, *, 2*" ColumnDefinitions="4*, *" ColumnSpacing="10">
    <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Enter url" VerticalOptions="Center" />
    <Entry Grid.Row="1" Grid.ColumnSpan="2" x:Name="urlEntry" Placeholder="https://..." Text="{Binding Url}">
      <Entry.Behaviors>
        <toolkit:TextValidationBehavior
          x:Name="validationBehavior"
          InvalidStyle="{StaticResource InvalidEntryStyle}"
          Flags="ValidateOnValueChanged"
          RegexPattern="^(http|https):\/\/\d*\D"
          IsValid="False"
        />
      </Entry.Behaviors>
    </Entry>
    <Button
      Grid.Row="2"
      Grid.Column="0"
      VerticalOptions="Center"
      HorizontalOptions="End"
      WidthRequest="80"
      Text="Cancel"
      Command="{Binding CancelCommand}"
      Style="{StaticResource TransparentButton}"
    />
    <Button
      Grid.Row="2"
      Grid.Column="1"
      VerticalOptions="Center"
      HorizontalOptions="End"
      WidthRequest="80"
      Text="Ok"
      Command="{Binding OkCommand}"
      IsEnabled="{Binding Source={x:Reference validationBehavior}, Path=IsValid}"
      Style="{StaticResource TransparentButton}"
    />
  </Grid>
</toolkit:Popup>
