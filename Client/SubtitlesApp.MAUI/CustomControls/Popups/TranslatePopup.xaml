<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels.Popups"
  xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
  xmlns:conv="clr-namespace:SubtitlesApp.Converters"
  xmlns:clientmodels="clr-namespace:SubtitlesApp.ClientModels"
  x:Class="SubtitlesApp.CustomControls.Popups.TranslatePopup"
  x:DataType="viewModels:TranslatePopupViewModel"
  x:TypeArguments="clientmodels:TranslationSettings"
  CanBeDismissedByTappingOutsideOfPopup="False"
  WidthRequest="300"
  BackgroundColor="Transparent"
>
  <toolkit:Popup.Resources>
    <conv:TimeSpanConverter x:Key="TimeSpanConverter" />
    <conv:AllTrueMultiConverter x:Key="AllTrueConverter" />
    <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
  </toolkit:Popup.Resources>
  <Border StyleClass="PopupBorder, PopupView">
    <Grid RowDefinitions="Auto, 20, 50, *" ColumnDefinitions="*, *" Padding="10">
      <uranium:StatefulContentView
        Grid.Row="0"
        Grid.ColumnSpan="2"
        Margin="0,0,0,10"
        TappedCommand="{Binding ChooseTargetLanguageCommand}"
      >
        <Border Padding="20">
          <VerticalStackLayout>
            <Label Text="Translation language" VerticalOptions="Center" HorizontalOptions="Center" />
            <Label Text="{Binding TargetLanguage.Name}" VerticalOptions="Center" HorizontalOptions="Center" />
          </VerticalStackLayout>
        </Border>
      </uranium:StatefulContentView>

      <Label Grid.Row="1" Grid.Column="0" Text="From" VerticalTextAlignment="End" />
      <Label Grid.Row="1" Grid.Column="1" Text="To" VerticalTextAlignment="End" />

      <Entry
        Grid.Row="2"
        Grid.Column="0"
        Placeholder="{Binding FromTime, StringFormat='{0:hh\\:mm\\:ss}'}"
        Text="{Binding FromTime, Mode=TwoWay, Converter={StaticResource TimeSpanConverter}}"
      >
        <Entry.Behaviors>
          <toolkit:TextValidationBehavior
            x:Name="fromValidationBehavior"
            InvalidStyle="{StaticResource InvalidEntryStyle}"
            ValidStyle="{StaticResource DefaultEntryStyle}"
            Flags="ValidateOnValueChanged"
            RegexPattern="^([01]\d|2[0-3]):([0-5]\d):([0-5]\d)$"
            IsValid="False"
          />
        </Entry.Behaviors>
      </Entry>
      <Entry
        Grid.Row="2"
        Grid.Column="1"
        Placeholder="{Binding ToTime, StringFormat='{0:hh\\:mm\\:ss}'}"
        Text="{Binding ToTime, Mode=TwoWay, Converter={StaticResource TimeSpanConverter}}"
      >
        <Entry.Behaviors>
          <toolkit:TextValidationBehavior
            x:Name="toValidationBehavior"
            InvalidStyle="{StaticResource InvalidEntryStyle}"
            ValidStyle="{StaticResource DefaultEntryStyle}"
            Flags="ValidateOnValueChanged"
            RegexPattern="^([01]\d|2[0-3]):([0-5]\d):([0-5]\d)$"
            IsValid="False"
          />
        </Entry.Behaviors>
      </Entry>

      <Button
        Grid.Row="3"
        Grid.Column="0"
        Text="Cancel"
        Command="{Binding CancelCommand}"
        Style="{StaticResource TransparentButton}"
      />
      <Button
        Grid.Row="3"
        Grid.Column="1"
        Text="Translate"
        Command="{Binding SaveCommand}"
        Style="{StaticResource TransparentButton}"
      >
        <Button.IsEnabled>
          <MultiBinding Converter="{StaticResource AllTrueConverter}">
            <Binding Source="{x:Reference fromValidationBehavior}" Path="IsValid" />
            <Binding Source="{x:Reference toValidationBehavior}" Path="IsValid" />
            <Binding Path="IsTimeRangeValid" />
            <Binding Path="TargetLanguage" Converter="{StaticResource IsNotNullConverter}" />
          </MultiBinding>
        </Button.IsEnabled>
      </Button>
    </Grid>
  </Border>
</toolkit:Popup>
