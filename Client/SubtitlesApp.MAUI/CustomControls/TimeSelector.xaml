<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:customControls="clr-namespace:SubtitlesApp.CustomControls"
  xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
  x:Class="SubtitlesApp.CustomControls.TimeSelector"
  x:DataType="customControls:TimeSelector"
  x:Name="root"
>
  <uranium:StatefulContentView BindingContext="{x:Reference root}" Tapped="OnTapped">
    <Border StrokeThickness="1" Padding="10,5">
      <Border.StrokeShape>
        <RoundRectangle CornerRadius="5" />
      </Border.StrokeShape>

      <Label
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Text="{Binding Value, Converter={StaticResource TimeSpanConverter}}"
      />
    </Border>
  </uranium:StatefulContentView>
</ContentView>
