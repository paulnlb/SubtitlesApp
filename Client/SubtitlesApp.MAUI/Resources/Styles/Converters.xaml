<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:customConverters="clr-namespace:SubtitlesApp.Converters"
  x:Class="SubtitlesApp.Resources.Styles.Converters"
>
  <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
  <customConverters:TimeSpanConverter x:Key="TimeSpanConverter" />
  <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
  <customConverters:SecondsToStringConverter x:Key="SecondsToStringConverter" />
  <customConverters:PathToFileNameConverter x:Key="PathToFileNameConverter" />
  <toolkit:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter" />
  <customConverters:SizeAndOrientationConverter x:Key="SizeAndOrientationConverter" />
  <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
  <toolkit:IsStringNullOrEmptyConverter x:Key="IsStringNullOrEmptyConverter" />
  <customConverters:AllTrueConverter x:Key="AllTrueConverter" />
</ResourceDictionary>
