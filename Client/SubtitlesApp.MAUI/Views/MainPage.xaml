<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels"
  x:Class="SubtitlesApp.Views.MainPage"
  x:DataType="viewModels:MainPageViewModel"
>
  <ContentPage.Resources>
    <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
  </ContentPage.Resources>

  <ScrollView>
    <Grid Padding="30,0" RowSpacing="15" RowDefinitions="*, Auto, Auto, *" ColumnDefinitions="*">
      <Label
        Grid.Row="0"
        Text="Transcribe and translate any video"
        Style="{StaticResource Headline}"
        SemanticProperties.HeadingLevel="Level1"
        VerticalOptions="Center"
        HorizontalOptions="Fill"
      />

      <Button
        Grid.Row="1"
        x:Name="CounterBtn"
        Text="Open a file"
        SemanticProperties.Hint="Opens a file to view"
        HorizontalOptions="Fill"
        Command="{Binding OpenMediaFileCommand}"
      />

      <Button
        Grid.Row="2"
        x:Name="SettingsBtn"
        Text="App settings"
        SemanticProperties.Hint="Opens app settings"
        HorizontalOptions="Fill"
        Command="{Binding OpenSettingsCommand}"
      />
    </Grid>
  </ScrollView>
</ContentPage>
