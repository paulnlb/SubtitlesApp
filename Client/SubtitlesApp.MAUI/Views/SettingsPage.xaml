<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels"
  x:Class="SubtitlesApp.Views.SettingsPage"
  x:DataType="viewModels:SettingsViewModelNew"
  Title="Settings"
  BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource DarkBackground}}"
  SafeAreaEdges="Container"
>
  <CollectionView
    ItemsSource="{Binding SettingsItems}"
    SelectionMode="None"
    Margin="0, 0, 0, 10"
    ItemTemplate="{x:StaticResource SettingItemsGroup}"
  />
</ContentPage>
