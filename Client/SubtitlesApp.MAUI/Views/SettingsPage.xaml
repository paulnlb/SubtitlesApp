<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:customControls="clr-namespace:SubtitlesApp.CustomControls"
  xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
  xmlns:settingsItems="clr-namespace:SubtitlesApp.ClientModels.SettingsItems"
  x:Class="SubtitlesApp.Views.SettingsPage"
  x:DataType="viewModels:SettingsViewModelNew"
  Title="Settings"
>
  <CollectionView ItemsSource="{Binding SettingsItems}" SelectionMode="None" IsGrouped="true">
    <CollectionView.GroupHeaderTemplate>
      <DataTemplate x:DataType="settingsItems:SettingsItemsGroup">
        <Label Text="{Binding Name}" Padding="5" FontSize="18" FontAttributes="Bold" />
      </DataTemplate>
    </CollectionView.GroupHeaderTemplate>
    <CollectionView.ItemTemplate>
      <DataTemplate x:DataType="settingsItems:SettingsItem">
        <VerticalStackLayout Margin="0, 5" Padding="5">
          <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding EditValueCommand}" CommandParameter="{Binding .}" />
          </VerticalStackLayout.GestureRecognizers>
          <Label Text="{Binding Title}" />
          <Label Text="{Binding SecondaryText}" />
        </VerticalStackLayout>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
