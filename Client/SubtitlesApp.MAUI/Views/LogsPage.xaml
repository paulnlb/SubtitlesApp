<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels"
  x:Class="SubtitlesApp.Views.LogsPage"
  x:DataType="viewModels:LogsPageViewModel"
  Title="View App Logs"
>
  <Grid RowDefinitions="50, 50, *">
    <Picker
      Grid.Row="0"
      FontSize="22"
      Title="Select a log file"
      ItemsSource="{Binding LogPaths}"
      SelectedItem="{Binding SelectedPath}"
    />
    <Button
      Grid.Row="1"
      Text="Clear Selected Log File"
      IsEnabled="{Binding SelectedPath, Converter={x:StaticResource IsStringNotNullOrEmptyConverter}}"
      Command="{Binding ClearLogCommand}"
    />
    <ScrollView Grid.Row="2" Orientation="Both">
      <Label FontSize="18" Text="{Binding LogsText}" />
    </ScrollView>
  </Grid>
</ContentPage>
