<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels"
  x:Class="SubtitlesApp.Views.LogsPage"
  x:DataType="viewModels:LogsPageViewModel"
  Title="View App Logs"
>
  <Grid RowDefinitions="50, 50, *" ColumnDefinitions="*, *, *" ColumnSpacing="10">
    <Picker
      Grid.Row="0"
      Grid.ColumnSpan="3"
      FontSize="18"
      Title="Select a log file"
      ItemsSource="{Binding LogFileNames}"
      SelectedItem="{Binding Selected}"
    />
    <Button Grid.Row="1" Grid.Column="0" Text="Load" Command="{Binding LoadLogCommand}">
      <Button.IsEnabled>
        <MultiBinding Converter="{x:StaticResource AllTrueConverter}">
          <Binding Path="Selected" Converter="{x:StaticResource IsStringNotNullOrEmptyConverter}" />
          <Binding Path="LogsText" Converter="{x:StaticResource IsStringNullOrEmptyConverter}" />
        </MultiBinding>
      </Button.IsEnabled>
    </Button>
    <Button
      Grid.Row="1"
      Grid.Column="1"
      Text="Export"
      Command="{Binding ExportLogCommand}"
      IsEnabled="{Binding Selected, Converter={x:StaticResource IsStringNotNullOrEmptyConverter}}"
    />
    <Button Grid.Row="1" Grid.Column="2" Text="Clear" Command="{Binding ClearLogCommand}">
      <Button.IsEnabled>
        <MultiBinding Converter="{x:StaticResource AllTrueConverter}">
          <Binding Path="Selected" Converter="{x:StaticResource IsStringNotNullOrEmptyConverter}" />
          <Binding Path="LogsText" Converter="{x:StaticResource IsStringNotNullOrEmptyConverter}" />
        </MultiBinding>
      </Button.IsEnabled>
    </Button>
    <ScrollView Grid.Row="2" Grid.ColumnSpan="3" Orientation="Both">
      <Label FontSize="18" Text="{Binding LogsText}" />
    </ScrollView>
  </Grid>
</ContentPage>
