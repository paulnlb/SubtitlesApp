<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels.Popups"
  xmlns:customControls="clr-namespace:SubtitlesApp.CustomControls"
  x:DataType="viewModels:TimeEntryPopupVm"
  x:Class="SubtitlesApp.Views.Popups.TimeEntryPopup"
  x:TypeArguments="x:TimeSpan"
  ControlTemplate="{StaticResource PopupTemplate}"
  x:Name="root"
>
  <customControls:TimeEntry TimeScope="Minutes" TimeValue="{Binding Value, Mode=TwoWay}" />
</toolkit:Popup>
