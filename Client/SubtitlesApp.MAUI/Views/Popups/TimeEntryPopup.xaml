<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels.Popups"
  xmlns:customControls="clr-namespace:SubtitlesApp.CustomControls"
  x:DataType="viewModels:TimeEntryPopupVm"
  x:Class="SubtitlesApp.Views.Popups.TimeEntryPopup"
  x:TypeArguments="x:TimeSpan"
  ControlTemplate="{StaticResource PopupTemplate}"
  x:Name="root"
>
  <StackLayout Orientation="Vertical" Spacing="20">
    <Label x:Name="timeLabel" HorizontalOptions="Center">
      <Label.FormattedText>
        <FormattedString>
          <Span Text="{Binding HourSection}" FontSize="22" />
          <Span Text="h " FontSize="15" />
          <Span Text="{Binding MinuteSection}" FontSize="22" />
          <Span Text="m " FontSize="15" />
          <Span Text="{Binding SecondSection}" FontSize="22" />
          <Span Text="s" FontSize="15" />
        </FormattedString>
      </Label.FormattedText>
    </Label>
    <Grid RowDefinitions="*, *, *, *" ColumnDefinitions="*, *, *" RowSpacing="10" ColumnSpacing="10">
      <Button
        Grid.Row="0"
        Grid.Column="0"
        Style="{StaticResource TranslucentButton}"
        Text="1"
        Command="{Binding AddCommand}"
        CommandParameter="1"
      />
      <Button
        Grid.Row="0"
        Grid.Column="1"
        Style="{StaticResource TranslucentButton}"
        Text="2"
        Command="{Binding AddCommand}"
        CommandParameter="2"
      />
      <Button
        Grid.Row="0"
        Grid.Column="2"
        Style="{StaticResource TranslucentButton}"
        Text="3"
        Command="{Binding AddCommand}"
        CommandParameter="3"
      />
      <Button
        Grid.Row="1"
        Grid.Column="0"
        Style="{StaticResource TranslucentButton}"
        Text="4"
        Command="{Binding AddCommand}"
        CommandParameter="4"
      />
      <Button
        Grid.Row="1"
        Grid.Column="1"
        Style="{StaticResource TranslucentButton}"
        Text="5"
        Command="{Binding AddCommand}"
        CommandParameter="5"
      />
      <Button
        Grid.Row="1"
        Grid.Column="2"
        Style="{StaticResource TranslucentButton}"
        Text="6"
        Command="{Binding AddCommand}"
        CommandParameter="6"
      />
      <Button
        Grid.Row="2"
        Grid.Column="0"
        Style="{StaticResource TranslucentButton}"
        Text="7"
        Command="{Binding AddCommand}"
        CommandParameter="7"
      />
      <Button
        Grid.Row="2"
        Grid.Column="1"
        Style="{StaticResource TranslucentButton}"
        Text="8"
        Command="{Binding AddCommand}"
        CommandParameter="8"
      />
      <Button
        Grid.Row="2"
        Grid.Column="2"
        Style="{StaticResource TranslucentButton}"
        Text="9"
        Command="{Binding AddCommand}"
        CommandParameter="9"
      />
      <Button
        Grid.Row="3"
        Grid.Column="0"
        Style="{StaticResource TranslucentButton}"
        Text="00"
        Command="{Binding AddCommand}"
        CommandParameter="00"
      />
      <Button
        Grid.Row="3"
        Grid.Column="1"
        Style="{StaticResource TranslucentButton}"
        Text="0"
        Command="{Binding AddCommand}"
        CommandParameter="0"
      />
      <Button
        Grid.Row="3"
        Grid.Column="2"
        Style="{StaticResource TranslucentButton}"
        ImageSource="{AppThemeBinding Light=backspace_dark, Dark=backspace_light}"
        Command="{Binding RemoveCommand}"
      />
    </Grid>
  </StackLayout>
</toolkit:Popup>
