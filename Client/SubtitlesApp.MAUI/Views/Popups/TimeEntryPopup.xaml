<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:viewModels="clr-namespace:SubtitlesApp.ViewModels.Popups"
  xmlns:constants="clr-namespace:SubtitlesApp.Constants"
  xmlns:conv="clr-namespace:SubtitlesApp.Converters"
  x:DataType="viewModels:TimeEntryPopupVm"
  x:Class="SubtitlesApp.Views.Popups.TimeEntryPopup"
  x:TypeArguments="x:TimeSpan"
  ControlTemplate="{StaticResource PopupTemplate}"
  WidthRequest="300"
  x:Name="root"
>
  <toolkit:Popup.Resources>
    <conv:TimeSpanConverter x:Key="TimeSpanConverter" />
  </toolkit:Popup.Resources>

  <Entry
    Placeholder="{Binding Value, StringFormat='{0:mm\\:ss}'}"
    Text="{Binding Value, Mode=TwoWay, Converter={StaticResource TimeSpanConverter}, ConverterParameter={x:Static constants:TimeSpanConverterConstants.MinutesMode}}"
  >
    <Entry.Behaviors>
      <toolkit:TextValidationBehavior
        x:Name="fromValidationBehavior"
        BindingContext="{Binding Source={x:Reference root}, Path=BindingContext}"
        InvalidStyle="{StaticResource InvalidEntryStyle}"
        ValidStyle="{StaticResource DefaultEntryStyle}"
        Flags="ValidateOnValueChanged"
        RegexPattern="^[0-5]\d:[0-5]\d$"
        IsValid="{Binding IsInputValid, Mode=OneWayToSource}"
      />
    </Entry.Behaviors>
  </Entry>
</toolkit:Popup>
