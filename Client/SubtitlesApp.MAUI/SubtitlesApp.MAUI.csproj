<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
    <!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

    <!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>SubtitlesApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>SubtitlesApp</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.companyname.subtitlesapp</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>0.5.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-android|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Images\fast_forward_icon.png" />
    <None Remove="Resources\Images\fast_rewind_icon.png" />
    <None Remove="Resources\Images\pause_icon.png" />
    <None Remove="Resources\Images\play_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FullScreenStatus.Maui" Version="1.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.70" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.70" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <PackageReference Include="Redth.Maui.VirtualListView" Version="0.4.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="UraniumUI.Material" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubtitlesApp.Infrastructure\SubtitlesApp.Infrastructure.csproj" />
    <ProjectReference Include="..\..\SubtitlesApp.Core\SubtitlesApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="CustomControls\PlayerControls.xaml.cs">
      <DependentUpon>PlayerControls.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Popups\EntryPopup.xaml.cs">
      <DependentUpon>EntryPopup.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Popups\TimeEntryPopup.xaml.cs">
      <DependentUpon>TimeEntryPopup.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Popups\UrlEntryPopup.xaml.cs">
      <DependentUpon>UrlEntryPopup.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SubtitlesView.xaml.cs">
      <DependentUpon>SubtitlesView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\PlayerWithSubtitlesPage.xaml.cs">
      <DependentUpon>PlayerWithSubtitlesPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SettingsPage.xaml.cs">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="CustomControls\LoadingButton.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Popups\EntryPopup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Popups\TimeEntryPopup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Popups\UrlEntryPopup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="CustomControls\PlayerControls.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="CustomControls\SubtitleCollection.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Resources\Styles\ContentTemplates.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Resources\Styles\CustomStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SubtitlesView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\PlayerWithSubtitlesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86_64\libffmpegwrapper.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86_64\libavcodec.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86_64\libavformat.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86_64\libavutil.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86_64\libswresample.so" />

    <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libffmpegwrapper.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libavcodec.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libavformat.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libavutil.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\arm64-v8a\libswresample.so" />

    <AndroidNativeLibrary Include="Platforms\Android\lib\armeabi-v7a\libffmpegwrapper.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\armeabi-v7a\libavcodec.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\armeabi-v7a\libavformat.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\armeabi-v7a\libavutil.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\armeabi-v7a\libswresample.so" />

    <AndroidNativeLibrary Include="Platforms\Android\lib\x86\libffmpegwrapper.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86\libavcodec.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86\libavformat.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86\libavutil.so" />
    <AndroidNativeLibrary Include="Platforms\Android\lib\x86\libswresample.so" />
  </ItemGroup>
</Project>
